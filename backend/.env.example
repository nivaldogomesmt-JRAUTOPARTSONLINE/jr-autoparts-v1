# ============================================================
# JR Auto Parts — backend/.env.example
# Copie para backend/.env e preencha os valores reais.
# NUNCA commite o .env com valores reais no repositorio.
# ============================================================

# ----- Servidor -----
NODE_ENV=development
PORT=3001

# ----- Banco de dados (Supabase / PostgreSQL) -----
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# ----- Autenticacao JWT -----
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d

# ----- CORS / Frontend -----
FRONTEND_URL=http://localhost:5173

# ----- Cloudinary (upload de imagens) -----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----- Resend (e-mail transacional) -----
RESEND_API_KEY=
EMAIL_FROM=noreply@seudominio.com.br

# ----- BotConversa (WhatsApp) -----
BOTCONVERSA_API_KEY=
BOTCONVERSA_API_URL=https://backend.botconversa.com.br/api/v1
WHATSAPP_FROM_NUMBER=5565900000000
BOT_SECRET_TOKEN=

# ----- Efi / Gerencia Net (cobrancas / boletos) -----
# Obtenha em: https://app.sejaefi.com.br -> API -> Credenciais
# homologation = ambiente de testes  |  production = producao
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_ENV=homologation
