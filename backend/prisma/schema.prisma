generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ USUÃƒÂRIOS Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  passwordHash     String    @map("password_hash")
  role             UserRole  @default(EMPLOYEE)
  active           Boolean   @default(true)
  mustChangePassword Boolean @default(true) @map("must_change_password")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  lastLoginAt      DateTime? @map("last_login_at")
  clientId         String?   @unique @map("client_id")
  client           Client?   @relation(fields: [clientId], references: [id])
  statusLogs       SoStatusLog[]
  permissions      UserPermission?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

enum UserRole {
  ADMIN
  EMPLOYEE
  CLIENT
}

model UserPermission {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  canAdd     Boolean  @default(true) @map("can_add")
  canEdit    Boolean  @default(true) @map("can_edit")
  canDelete  Boolean  @default(true) @map("can_delete")
  canManageUsers Boolean @default(false) @map("can_manage_users")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_permissions")
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ CLIENTES Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
model Client {
  id            String        @id @default(uuid())
  name          String
  cpfCnpj       String?       @unique @map("cpf_cnpj")
  phone         String?
  whatsapp      String?
  email         String?       @unique
  address       String?
  city          String?
  type          ClientType    @default(PERSONAL)
  active        Boolean       @default(true)
  user          User?
  vehicles      Vehicle[]
  serviceOrders ServiceOrder[]
  messages      WhatsappMessage[]
  trackingDevices TrackingDevice[]
  trackingContracts TrackingContract[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("clients")
}

enum ClientType {
  PERSONAL
  BUSINESS
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ VEÃƒÂCULOS Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
model Vehicle {
  id            String        @id @default(uuid())
  clientId      String        @map("client_id")
  plate         String        @unique
  brand         String
  model         String
  year          Int?
  color         String?
  fuel          String?
  currentKm     Int?          @map("current_km")
  notes         String?
  active        Boolean       @default(true)
  client        Client        @relation(fields: [clientId], references: [id])
  serviceOrders ServiceOrder[]
  maintenances  PreventiveMaintenance[]
  trackingDevices TrackingDevice[]
  trackingContracts TrackingContract[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("vehicles")
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ PRODUTOS Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String?
  price       Decimal  @db.Decimal(10, 2)
  photoUrl    String?  @map("photo_url")
  unit        String   @default("un")
  stock       Int?     @default(0)
  active      Boolean  @default(true)
  soItems     SoItem[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("products")
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ SERVIÃƒâ€¡OS Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
model Service {
  id            String   @id @default(uuid())
  name          String
  description   String?
  price         Decimal  @db.Decimal(10, 2)
  estimatedTime Int?     @map("estimated_time")
  active        Boolean  @default(true)
  soItems       SoItem[]
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("services")
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ ORDEM DE SERVIÃƒâ€¡O Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
model ServiceOrder {
  id          String     @id @default(uuid())
  number      Int        @unique @default(autoincrement())
  clientId    String     @map("client_id")
  vehicleId   String     @map("vehicle_id")
  status      SoStatus   @default(QUOTE)
  entryKm     Int?       @map("entry_km")
  notes       String?
  totalPrice  Decimal    @default(0) @db.Decimal(10, 2) @map("total_price")
  createdById String?    @map("created_by_id")
  client      Client     @relation(fields: [clientId], references: [id])
  vehicle     Vehicle    @relation(fields: [vehicleId], references: [id])
  items       SoItem[]
  statusLogs  SoStatusLog[]
  messages    WhatsappMessage[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("service_orders")
}

enum SoStatus {
  QUOTE
  APPROVED
  STARTED
  IN_PROGRESS
  WAITING_PART
  FINISHING
  DONE
  DELIVERED
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ ITENS DA OS Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
model SoItem {
  id           String       @id @default(uuid())
  soId         String       @map("so_id")
  type         ItemType
  productId    String?      @map("product_id")
  serviceId    String?      @map("service_id")
  itemName     String       @map("item_name")
  quantity     Decimal      @db.Decimal(10, 3)
  unitPrice    Decimal      @map("unit_price") @db.Decimal(10, 2)
  serviceOrder ServiceOrder @relation(fields: [soId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id])
  service      Service?     @relation(fields: [serviceId], references: [id])
  createdAt    DateTime     @default(now()) @map("created_at")

  @@map("so_items")
}

enum ItemType {
  PRODUCT
  SERVICE
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ LOG DE STATUS DA OS Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
model SoStatusLog {
  id           String    @id @default(uuid())
  soId         String    @map("so_id")
  oldStatus    SoStatus? @map("old_status")
  newStatus    SoStatus  @map("new_status")
  userId       String?   @map("user_id")
  serviceOrder ServiceOrder @relation(fields: [soId], references: [id])
  user         User?     @relation(fields: [userId], references: [id])
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("so_status_logs")
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ MANUTENÃƒâ€¡ÃƒÆ’O PREVENTIVA Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
model PreventiveMaintenance {
  id             String    @id @default(uuid())
  vehicleId      String    @map("vehicle_id")
  type           String
  label          String
  intervalKm     Int?      @map("interval_km")
  intervalMonths Int?      @map("interval_months")
  lastDate       DateTime? @map("last_date")
  lastKm         Int?      @map("last_km")
  nextDate       DateTime? @map("next_date")
  nextKm         Int?      @map("next_km")
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id])
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([vehicleId, type])
  @@map("preventive_maintenances")
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ MENSAGENS WHATSAPP Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
model WhatsappMessage {
  id           String        @id @default(uuid())
  clientId     String        @map("client_id")
  soId         String?       @map("so_id")
  phone        String
  content      String
  status       MessageStatus @default(PENDING)
  attempts     Int           @default(0)
  errorMessage String?       @map("error_message")
  sentAt       DateTime?     @map("sent_at")
  client       Client        @relation(fields: [clientId], references: [id])
  serviceOrder ServiceOrder? @relation(fields: [soId], references: [id])
  createdAt    DateTime      @default(now()) @map("created_at")

  @@map("whatsapp_messages")
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
}

// â€”â€” ATIVOS DA EMPRESA â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”
model CompanyAsset {
  id          String      @id @default(uuid())
  code        String?     @unique
  name        String
  category    AssetCategory
  plate       String?     @unique
  identifier  String?
  intendedUse String?     @map("intended_use")
  description String?
  status      AssetStatus @default(ACTIVE)
  notes       String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([category])
  @@index([status])
  @@map("company_assets")
}

enum AssetCategory {
  TOW_TRUCK
  CAR
  MOTORCYCLE
  EQUIPMENT
  DEVICE
  OTHER
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  FOR_SALE
  FOR_RENT
}

// â€”â€” CONTAS E CANAIS DIGITAIS â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”
model DigitalAccount {
  id          String               @id @default(uuid())
  code        String?              @unique
  platform    DigitalAccountType
  label       String
  contact     String?
  plan        String?
  status      DigitalAccountStatus @default(ACTIVE)
  verified    Boolean              @default(false)
  notes       String?
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@index([platform])
  @@index([status])
  @@map("digital_accounts")
}

enum DigitalAccountType {
  WHATSAPP_BUSINESS
  OLX
  BOTCONVERSA
  INSTAGRAM
  FACEBOOK
  CHATGPT
  CLAUDE
  MAKE
  GMAIL_WORKSPACE
  OTHER
}

enum DigitalAccountStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model TrackingDevice {
  id          String               @id @default(uuid())
  clientId    String?              @map("client_id")
  vehicleId   String?              @map("vehicle_id")
  model       String
  imei        String               @unique
  chipNumber  String?              @map("chip_number")
  carrier     String?
  status      TrackingDeviceStatus @default(STOCK)
  installedAt DateTime?            @map("installed_at")
  notes       String?
  client      Client?              @relation(fields: [clientId], references: [id])
  vehicle     Vehicle?             @relation(fields: [vehicleId], references: [id])
  contracts   TrackingContract[]
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@index([status])
  @@index([clientId])
  @@index([vehicleId])
  @@map("tracking_devices")
}

enum TrackingDeviceStatus {
  ACTIVE
  STOCK
  MAINTENANCE
  REMOVED
}

model TrackingContract {
  id             String                @id @default(uuid())
  clientId       String                @map("client_id")
  vehicleId      String                @map("vehicle_id")
  deviceId       String                @map("device_id")
  monthlyAmount  Decimal               @db.Decimal(10, 2) @map("monthly_amount")
  dueDay         Int                   @map("due_day")
  startDate      DateTime              @map("start_date")
  endDate        DateTime?             @map("end_date")
  status         TrackingContractStatus @default(ACTIVE)
  notes          String?
  client         Client                @relation(fields: [clientId], references: [id])
  vehicle        Vehicle               @relation(fields: [vehicleId], references: [id])
  device         TrackingDevice        @relation(fields: [deviceId], references: [id])
  invoices       TrackingInvoice[]
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  @@index([status])
  @@index([clientId])
  @@index([vehicleId])
  @@index([deviceId])
  @@map("tracking_contracts")
}

enum TrackingContractStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

model TrackingInvoice {
  id             String               @id @default(uuid())
  contractId     String               @map("contract_id")
  referenceMonth String               @map("reference_month")
  dueDate        DateTime             @map("due_date")
  paidAt         DateTime?            @map("paid_at")
  amount         Decimal              @db.Decimal(10, 2)
  status         TrackingInvoiceStatus @default(PENDING)
  notes          String?
  contract       TrackingContract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@unique([contractId, referenceMonth])
  @@index([status])
  @@index([dueDate])
  @@map("tracking_invoices")
}

enum TrackingInvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}


