EFI_CLIENT_ID=Client_Id_e946e8253da4c696389d806c42ebf9f086d517b2
EFI_CLIENT_SECRET=Client_Secret_d5b2a7b521c71804a76c05c86a63505750308da4
EFI_ENV=production

# As variáveis abaixo são injetadas pelo docker-compose.yml
# DATABASE_URL=postgresql://postgres:postgres@db:5432/jrautoparts
# JWT_SECRET=jrautoparts-docker-dev-secret
# FRONTEND_URL=http://localhost:5173
# PORT=3001

# WhatsApp Provider: "botconversa" ou "evolution"
WHATSAPP_PROVIDER=evolution

# Evolution API
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=jr-autoparts-evo-global-key-change-me
EVOLUTION_INSTANCE_NAME=jrautoparts

# URL que a Evolution API usa para enviar webhooks (comunicação interna Docker)
EVOLUTION_WEBHOOK_URL=http://backend:3001/api/webhooks/evolution

BOT_SECRET_TOKEN=troque-por-um-token-de-24-caracteres-ou-mais
BOT_SESSION_TTL_MINUTES=30
BOT_BOLETO_NOTIFY_ENABLED=false
BOT_BOLETO_DUE_SOON_DAYS=3
BOT_BOLETO_NOTIFY_MAX_CLIENTS=300
BOT_BOLETO_NOTIFY_BATCH_SIZE=100
BOT_BOLETO_LOOKBACK_DAYS=60
BOT_BOLETO_LOOKAHEAD_DAYS=15
